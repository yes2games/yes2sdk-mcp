{
  "name": "@yes2games/yes2sdk-mcp",
  "version": "0.3.0",
  "description": "One integration ships your HTML5 game to every supported web game platform. Docs and the checks that catch a rejection before you submit, for AI assistants.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yes2games/yes2sdk-mcp.git"
  },
  "homepage": "https://developer.yes2games.com",
  "bugs": {
    "url": "https://github.com/yes2games/yes2sdk-mcp/issues"
  },
  "type": "module",
  "bin": {
    "yes2sdk-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "docs",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepare": "tsc",
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "http": "node dist/http.js",
    "dev:http": "tsx src/http.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "sync-docs": "node scripts/sync-docs.mjs",
    "sync-compliance": "node scripts/sync-compliance.mjs",
    "sync-sdk-meta": "node scripts/sync-sdk-meta.mjs",
    "check:sdk-meta": "node scripts/check-sdk-meta-sync.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.4"
  }
}
