[Unit]
Description=Yes2SDK MCP remote HTTP server
After=network-online.target

[Container]
Image=localhost/mcp:master
PublishPort=127.0.0.1:8091:8091
Environment=PORT=8091
Environment=NODE_ENV=production
HealthCmd=curl -fsS http://127.0.0.1:8091/health || exit 1
HealthInterval=10s
HealthTimeout=5s
HealthRetries=3
HealthStartPeriod=15s
HealthOnFailure=restart
PodmanArgs=--memory=192m --cpus=0.5

[Service]
Restart=always
RestartSec=5s

[Install]
WantedBy=default.target
